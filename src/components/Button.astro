---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  rel?: string;
}

const { href, variant = 'primary', rel } = Astro.props;
---

<a class:list={['button', variant]} href={href} rel={rel}><slot /></a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 1ch;
    font-size: var(--text-size-label);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: var(--leading-flat);
    text-decoration: none;
    padding: var(--space-s) var(--space-m);
    border: 2px solid var(--color-border-key);
    border-radius: var(--rounded-sm);
    box-shadow: var(--shadow-key);
    transition:
      transform 0.08s ease,
      box-shadow 0.08s ease,
      background-color 0.08s ease;
  }

  .button:hover {
    transform: translate(var(--key-hover-shift), var(--key-hover-shift));
    box-shadow: var(--shadow-key-hover);
  }

  .primary {
    background-color: var(--color-accent-fill);
    color: var(--color-on-accent);
  }

  .primary:hover {
    background-color: var(--color-accent-fill-hover);
  }

  .secondary {
    background-color: var(--color-light-glare);
    color: var(--color-gray-3);
  }

  .ghost {
    background-color: transparent;
    color: var(--color-gray-9);
    border: 1px solid var(--color-gray-7);
    box-shadow: none;
  }

  .ghost:hover {
    transform: none;
    border-color: var(--color-gray-9);
  }

  .button:focus-visible {
    outline: 2px dashed var(--color-accent);
    outline-offset: 3px;
  }
</style>
